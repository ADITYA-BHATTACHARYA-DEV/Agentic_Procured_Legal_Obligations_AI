OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# --- Reminders (all optional; the in-app notification log always works) ---
REMINDER_HOUR=9
DEFAULT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=obligo@localhost
SLACK_WEBHOOK_URL=

# --- Handwriting / multilingual vision (on-prem, via Ollama: ollama pull gemma3:4b) ---
VISION_ENABLED=true
VISION_MODEL=gemma3:4b
VISION_VERIFY_PASSES=2
VISION_MIN_AGREEMENT=0.85
VISION_MAX_TOKENS=2048

# --- Security (see SECURITY.md) ---
# 32-byte key, urlsafe-base64. Generate with: python -m app.tools.security_cli gen-master-key
# If empty, a key file is created at data/master.key (fine for a laptop, not for a shared server).
OBLIGO_MASTER_KEY=
# If set, every /api call must send "Authorization: Bearer <token>". The browser asks for it once.
OBLIGO_API_TOKEN=
# Comma-separated list of frontend origins allowed to call the API, e.g. https://obligo.example.com
ALLOWED_ORIGINS=*
ENCRYPT_AT_REST=true
